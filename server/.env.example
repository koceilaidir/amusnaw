# Domaine public de l'API (DNS pointé vers le VPS)
API_DOMAIN=api.exemple.com

POSTGRES_PASSWORD=change-moi

# Secret de signature des jetons Amusnaw (générer : openssl rand -hex 32)
JWT_SECRET=change-moi
JWT_DAYS=30

# Google : IDs clients OAuth acceptés (Web, iOS, Android), séparés par des virgules
GOOGLE_CLIENT_IDS=xxxx.apps.googleusercontent.com

# Apple : bundle ID de l'app iOS (et Service ID si connexion web)
APPLE_CLIENT_IDS=dz.amusnaw.amusnaw

# Modèle du prof : tout serveur compatible OpenAI.
#  - Ollama local (gratuit) : http://ollama:11434/v1  + LLM_MODEL=qwen2.5:7b
#  - plus tard : ton propre modèle (vLLM) ou une API
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b

# Code d'accès à la page de relecture https://<API_DOMAIN>/review (long et secret)
REVIEW_TOKEN=change-moi

# Connexion de test sans Google/Apple : true seulement pendant la bêta fermée
# Bouton « Continuer sans compte » (prénom seulement) : true pour la démo et les téléphones sans Google
DEV_LOGIN=false
# Adresse de contact de la politique de confidentialité (une adresse dédiée, pas personnelle)
CONTACT_EMAIL=

# Connexion par e-mail (code à 6 chiffres) avec Brevo — voir docs/EMAIL_BREVO.md
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Amusnaw

# Citer les ouvrages d'origine dans les réponses (false sur le site public)
SHOW_SOURCES=false

# Moteur de traduction NLLB (service « mt », lancé avec --profile mt). Vide = désactivé.
MT_URL=http://mt:8100
# Processeurs donnés à NLLB (voir `nproc`) et modèle utilisé (vide = NLLB de base)
MT_THREADS=2
MT_MODEL_DIR=
