# Adresse principale du site (dans .env : API_DOMAIN=amusnaw.cc)
{$API_DOMAIN} {
	encode gzip

	# API du prof (même adresse que le site : pas de souci de CORS)
	@api path /health /auth/* /me /me/* /tutor/* /content/* /learning/* /privacy /review /review/*
	handle @api {
		reverse_proxy api:8000
	}

	# Site web Amusnaw (flutter build web → server/web)
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
		@html path / /index.html
		header @html Cache-Control "no-cache"
	}
}

# Anciennes adresses et www → adresse principale (308 : garde les POST de l'API)
{$OLD_DOMAINS:www.localhost} {
	redir https://{$API_DOMAIN}{uri} 308
}
